# Firebase Client SDK — konfiguracja z konsoli Firebase (Ustawienia projektu)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Adres jedynego konta z dostępem do /admin (weryfikowany po stronie serwera)
ADMIN_EMAIL=

# Stripe — konfiguracja płatności w trybie testowym
# Klucz prywatny do inicjalizacji sesji po stronie serwera (sk_test_... lub rk_test_...)
STRIPE_SECRET_KEY=
# Klucz publiczny do formularzy klienta / Stripe Elements (pk_test_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Sekret webhooka Stripe (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Bazowy adres URL aplikacji do przekierowań success_url / cancel_url.
# Lokalnie: http://localhost:3000, na Vercel: produkcyjna domena, np. https://aura-ring.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
